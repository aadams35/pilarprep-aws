{
  "name": "pilarprep-aws",
  "version": "1.0.0",
  "private": true,
  "description": "Customer briefing and meeting intelligence on AWS",
  "repository": { "type": "git", "url": "https://github.com/aadams35/pilarprep-aws.git" },
  "homepage": "https://pilarprep.app",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --mode aws-static",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:backend": "npm run test:pipeline && npm run test:bedrock && npm run test:agentcore",
    "test:pipeline": "python -m unittest discover backend/pipeline/tests",
    "test:bedrock": "python -m unittest discover backend/bedrock/tests",
    "test:agentcore": "python -m unittest discover backend/agentcore/tests",
    "test:e2e": "playwright test",
    "eval:briefs": "node evals/brief-quality.mjs",
    "eval:models": "python -m evals.model_eval",
    "test:evals": "python -m unittest discover evals/tests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:publication": "node scripts/check-publication.mjs",
    "verify": "npm run check:publication && npm run typecheck && npm run lint && npm test && npm run test:backend && npm run test:evals && npm run eval:briefs && npm run build && npm run test:e2e",
    "demo:agentcore": "python backend/agentcore/local_demo.py",
    "smoke:aws": "node scripts/smoke-aws-live.mjs",
    "smoke:agentcore": "node scripts/smoke-agentcore-live.mjs",
    "smoke:pipeline": "node scripts/smoke-jobs-pipeline-live.mjs",
    "smoke:meeting": "node scripts/smoke-meeting-live.mjs"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@smithy/protocol-http": "^5.5.16",
    "@smithy/signature-v4": "^5.6.12",
    "@smithy/types": "4.16.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
